# Copy this file to .env and fill in your values.
# Never commit the actual .env file.

DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/shrek_story_db

# Separate PostgreSQL database used only for pytest.
TEST_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/shrek_story_test_db

# JWT authentication settings
SECRET_KEY=YOUR_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=30