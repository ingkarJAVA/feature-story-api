# Copy this file to .env and replace YOUR_PASSWORD. Never commit .env.
# If your password has special characters (@ : / # %), URL-encode them (@ -> %40).
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/shrek_story_db

# Separate database used ONLY by pytest (its data is wiped on every test run).
# Create it once:  psql -U postgres -c "CREATE DATABASE shrek_story_test_db;"
TEST_DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/shrek_story_test_db# Copy this file to .env and replace YOUR_PASSWORD.
# Never commit .env.

DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/shrek_story_db

# Separate database used only for pytest.
TEST_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/shrek_story_test_db
